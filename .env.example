# Spoke-Stack ENV-Vorlage. Produktiv: /etc/spoke-stack/env (chmod 600).

# --- Image-Tags -------------------------------------------------------------
OLLAMA_TAG=latest
RERANKER_TAG=latest
VISION_TAG=latest
SPOKE_AGENT_TAG=latest

# --- Spoke-Identitaet -------------------------------------------------------
# Pflicht. Pro Host eindeutig.
SPOKE_NAME=gpu-host
SPOKE_TAGS=gpu,linux,rtx5070ti
# Optional: vom Router vergebene App-ID
APP_ID=

# --- Router-Anbindung -------------------------------------------------------
# Pflicht: Adresse des llm-routers (Port 7842). Der CHANGEME-Praefix sorgt
# dafuer, dass install.sh/bootstrap.sh abbrechen, bis der Wert gesetzt ist.
ROUTER_URL=CHANGEME-http://<router-host>:7842
FALLBACK_ROUTER_URL=
API_KEY=
SPOKE_REGISTRATION_TOKEN=

# --- Spoke-Agent ------------------------------------------------------------
SPOKE_AGENT_ADMIN_PASSWORD=CHANGEME-vom-vault
# "off" deaktiviert Login (NUR fuer Tailscale-only Setups)
SPOKE_AGENT_AUTH=on
SPOKE_AGENT_PORT=7844

# --- Bind-Adressen ---------------------------------------------------------
# SICHERHEIT: ollama hat KEINE Built-in-Auth. Default ist 127.0.0.1 — auf
# Tailscale-only Hosts dann mit 'tailscale ip -4' die Tailscale-IP eintragen,
# damit der Service NUR im Tailnet erreichbar ist.
#
# Beispiele:
#   - Localhost only:         OLLAMA_BIND=127.0.0.1
#   - Nur im Tailnet:         OLLAMA_BIND=<tailscale-ip>
#   - Open (NUR im LAN, ohne Auth, NICHT in Production!): OLLAMA_BIND=0.0.0.0
OLLAMA_BIND=127.0.0.1
RERANKER_BIND=127.0.0.1
VISION_BIND=127.0.0.1

# --- Ollama ----------------------------------------------------------------
# Modell-Verzeichnis. Wenn ein systemd-Service `ollama.service` existiert,
# erkennt bootstrap.sh das automatisch und setzt OLLAMA_DATA_DIR auf das
# bestehende Verzeichnis (typisch /usr/share/ollama/.ollama). Modelle bleiben
# damit erhalten — KEIN neuer 50GB-Pull noetig.
OLLAMA_DATA_DIR=/var/lib/ollama

# Modell-Lifecycle
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_CTX=8192
OLLAMA_HOST=0.0.0.0

# --- GPU --------------------------------------------------------------------
# Anzahl GPUs an den Container reichen. Auto-detected ueber nvidia-smi -L.
# Manuell setzen wenn der Host mehrere GPUs hat aber nur eine genutzt werden soll.
# GPU_COUNT=1                  # Single-GPU-Host
# GPU_COUNT=2                  # Desktop (5060 + 5070)
GPU_COUNT=1

# --- Reranker --------------------------------------------------------------
RERANKER_DEVICE=cpu
RERANKER_DEFAULT_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_PRELOAD_MODELS=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=

# --- Vision ----------------------------------------------------------------
VISION_DEVICE=cpu
VISION_API_KEY=
