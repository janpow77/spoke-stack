# Spoke-Stack ENV-Vorlage. Produktiv: /etc/spoke-stack/env (chmod 600).

# --- Image-Tags -------------------------------------------------------------
OLLAMA_TAG=latest
RERANKER_TAG=latest
VISION_TAG=latest
SPOKE_AGENT_TAG=latest

# --- Spoke-Identitaet -------------------------------------------------------
# Pflicht. Pro Host eindeutig.
SPOKE_NAME=nuc
SPOKE_TAGS=gpu,linux,rtx5070ti
# Optional: vom Router vergebene App-ID
APP_ID=

# --- Router-Anbindung -------------------------------------------------------
ROUTER_URL=http://100.99.159.80:8080
FALLBACK_ROUTER_URL=
API_KEY=
SPOKE_REGISTRATION_TOKEN=

# --- Spoke-Agent ------------------------------------------------------------
SPOKE_AGENT_ADMIN_PASSWORD=CHANGEME-vom-vault
# "off" deaktiviert Login (NUR fuer Tailscale-only Setups)
SPOKE_AGENT_AUTH=on
SPOKE_AGENT_PORT=7844

# --- Bind-Adressen ---------------------------------------------------------
# Auf Tailscale-only Hosts: TAILSCALE-IP setzen, damit die Services NICHT
# von ausserhalb erreichbar sind. Beispiel NUC: 100.102.132.11
OLLAMA_BIND=0.0.0.0
RERANKER_BIND=0.0.0.0
VISION_BIND=0.0.0.0

# --- Ollama ----------------------------------------------------------------
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=2
OLLAMA_FLASH_ATTENTION=1

# --- Reranker --------------------------------------------------------------
RERANKER_DEVICE=cpu
RERANKER_DEFAULT_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_PRELOAD_MODELS=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=

# --- Vision ----------------------------------------------------------------
VISION_DEVICE=cpu
VISION_API_KEY=
